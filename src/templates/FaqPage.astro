---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContent, getUi } from '../lib/content';
import { assetUrl } from '../lib/photos';
import type { Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'en';
const { site, faq } = getContent(locale);
const ui = getUi(locale);
const { title, questions, gifts } = faq;
---

<BaseLayout title={`${title} · ${site.name}`} bodyClass="page-faq" locale={locale}>
  <section class="az-section az-faq" aria-labelledby="az-faq-heading">
    <div class="container az-page-width">
      {
        questions.length > 0 ? (
          <div class="az-faq__intro">
            {title && <h1 id="az-faq-heading" class="az-faq__title">{title}</h1>}
            <button
              type="button"
              class="az-faq__toggle-all"
              data-az-faq-toggle-all
              data-expand-label={ui.faq.expandAll}
              data-collapse-label={ui.faq.collapseAll}
              aria-expanded="false"
            >
              {ui.faq.expandAll}
            </button>
          </div>
        ) : (
          title && <h1 id="az-faq-heading" class="az-faq__title">{title}</h1>
        )
      }
      {
        questions.length > 0 && (
          <div class="az-faq__layout" data-az-faq>
            <div class="az-faq__list" role="list">
              {
                questions.map((row, index) => (
                  <div
                    class="az-faq__item"
                    role="listitem"
                    data-tooltip-color={row.tooltipColor}
                  >
                    <div class="az-faq__divider" aria-hidden="true"></div>
                    <button
                      type="button"
                      class="az-faq__question"
                      id={`az-faq-item-${index}`}
                      aria-expanded="false"
                      aria-controls={`az-faq-item-${index}-panel`}
                      data-az-faq-trigger
                    >
                      <span class="az-faq__bullet" aria-hidden="true">►</span>
                      <span class="az-faq__question-text">{row.question}</span>
                    </button>
                    <div
                      id={`az-faq-item-${index}-panel`}
                      class="az-faq__answer"
                      role="region"
                      aria-labelledby={`az-faq-item-${index}`}
                      hidden
                    >
                      {row.answer
                        .split(/\n+/)
                        .map((line) => line.trim())
                        .filter(Boolean)
                        .map((line) => (
                          <p set:html={line} />
                        ))}
                      {row.images && row.images.length > 0 ? (
                        <div
                          class="az-faq__answer-images"
                          role="group"
                          aria-label={row.imagesGalleryAlt || ui.faq.answerImages}
                        >
                          <div class="az-faq__answer-images-row">
                            {row.images.slice(0, 2).map((img) => (
                              <img
                                src={assetUrl(img.file)}
                                alt={img.alt || ''}
                                loading="lazy"
                                decoding="async"
                              />
                            ))}
                          </div>
                          {row.images.length > 2 && (
                            <div class="az-faq__answer-images-row">
                              {row.images.slice(2, 4).map((img) => (
                                <img
                                  src={assetUrl(img.file)}
                                  alt={img.alt || ''}
                                  loading="lazy"
                                  decoding="async"
                                />
                              ))}
                            </div>
                          )}
                        </div>
                      ) : (
                        row.image && (
                          <img
                            class="az-faq__answer-image"
                            src={assetUrl(row.image)}
                            alt={row.imageAlt || ''}
                            loading="lazy"
                            decoding="async"
                          />
                        )
                      )}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        )
      }
    </div>
  </section>
  {
    gifts && (
      <section id="az-faq-gifts" class="az-section az-section--dark az-faq-gifts" aria-labelledby="az-faq-gifts-title">
        <div class="container az-page-width">
          <div class="row align-items-center gy-5 gx-lg-5">
            <div class="col-lg-7">
              <p class="az-faq-gifts__eyebrow">{gifts.eyebrow}</p>
              <h2 id="az-faq-gifts-title" class="az-faq-gifts__title">{gifts.title}</h2>
              <div class="az-faq-gifts__body">
                {gifts.paragraphs.map((paragraph) => (
                  <p set:html={paragraph} />
                ))}
              </div>
            </div>
            <div class="col-lg-5">
              <figure class="az-faq-gifts__card">
                <img
                  src={assetUrl(gifts.qr)}
                  alt={gifts.qrAlt}
                  width="380"
                  height="380"
                  decoding="async"
                />
                <figcaption class="az-faq-gifts__caption">
                  <span class="az-faq-gifts__method">{gifts.method}</span>
                  <span class="az-faq-gifts__recipient">{gifts.recipient}</span>
                  {
                    gifts.linkUrl && gifts.linkLabel && (
                      <a class="az-faq-gifts__pay" href={gifts.linkUrl}>
                        {gifts.linkLabel}
                      </a>
                    )
                  }
                  {
                    gifts.copyValue ? (
                      <button
                        type="button"
                        class="az-faq-gifts__copy"
                        data-az-gift-copy={gifts.copyValue}
                        data-copy-label={gifts.copyLabel}
                        data-copied-label={gifts.copiedLabel}
                      >
                        <span class="az-faq-gifts__detail">{gifts.detail}</span>
                        <span class="az-faq-gifts__copy-state" aria-live="polite">
                          {gifts.copyLabel}
                        </span>
                      </button>
                    ) : gifts.linkUrl ? (
                      <a
                        class="az-faq-gifts__detail"
                        href={gifts.linkUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {gifts.detail}
                      </a>
                    ) : (
                      <span class="az-faq-gifts__detail">{gifts.detail}</span>
                    )
                  }
                </figcaption>
              </figure>
            </div>
          </div>
        </div>
      </section>
    )
  }
  <script slot="scripts" src="/assets/js/faq-accordion.js" defer></script>
</BaseLayout>
